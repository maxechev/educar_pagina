# Copiar este archivo como .env y completar los valores localmente.
SECRET_KEY=generar-una-clave-segura-y-unica
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# En desarrollo Django imprime los correos en la consola.
# En producción, configurar el backend SMTP y cargar las credenciales en el servicio.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10

CSRF_TRUSTED_ORIGINS=https://educar-production.up.railway.app
